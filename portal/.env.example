# CHUNIL Smart Mail Portal — 실행 설정 (복사해서 .env 로 저장)

# 서버가 열 포트. 팀원 주소는 http://<이 PC의 IPv4>:8080
PORT=8080

# 같은 사내망에서 접속을 받으려면 0.0.0.0 (기본). 이 PC에서만 쓰려면 127.0.0.1
HOST=0.0.0.0

# 메일 요약·할 일·기한 자동 분석 (Google AI Studio 키). 없으면 기본 규칙 모드로 동작합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 자동 메일 수집 주기(초). 기본 600 = 10분
SYNC_INTERVAL=600

# 처음 로그인한 사용자의 초기 수집 범위
SEED_DAYS=14
SEED_MAX=30

# 웹메일 IP 보안접속 사용 여부(보통 1). 서버 IP가 차단되면 전산팀에 허용 요청
NMAIL_IP_CHECK=1

# 조직도(공용 주소록)를 며칠마다 다시 받을지 (기본 1 = 하루 1회)
SHARED_CONTACTS_DAYS=1

# 과거 메일 백필 — 10분 자동 갱신이 끝난 뒤 사용자별로 이만큼씩 지난 메일을 채웁니다.
# 0 으로 두면 백필을 끕니다. BACKFILL_S_DATE=0 은 전체 기간(2024년 이전까지)을 뜻합니다.
BACKFILL_LIMIT=100
BACKFILL_PAGES=30
BACKFILL_S_DATE=0
BACKFILL_SKIP_ITEMS=500

# 본문 인라인 이미지 포함 (1=포함, 0=제외 — 데이터가 가벼워짐)
PORTAL_IMAGES=1

# 세션 유지 시간 (자동 로그인 체크 안 했을 때 / 체크했을 때의 일수)
SESSION_HOURS=12
REMEMBER_DAYS=30

# ── 자동 업데이트 (v1.2.0~) ────────────────────────────────────────────────
# 서버가 5분마다 GitHub 의 portal/manifest.json 을 확인해 바뀐 파일만 받아 스스로 끌어옵니다.
#   · index.html  → 재시작 없이 F5 만으로 적용
#   · server.py·scripts/*.py → 문법 검사 후 새 프로세스로 자동 재시작
#   · data/·이 파일(.env)은 절대 건드리지 않습니다.
PORTAL_UPDATE_URL=https://raw.githubusercontent.com/seongkuy0427-blip/mail-board-template/main/portal
PORTAL_AUTO_UPDATE=1
PORTAL_UPDATE_INTERVAL=300
